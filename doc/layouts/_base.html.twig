<!DOCTYPE html>
<html lang="{{ site.language }}" data-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <script>
            (function () {
                try {
                    var stored = localStorage.getItem('automate-theme');
                    var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                    document.documentElement.setAttribute('data-theme', theme);
                } catch (e) {}
            })();
        </script>
        <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)">
        <meta name="theme-color" content="#0f1620" media="(prefers-color-scheme: dark)">
        <meta name="color-scheme" content="light dark">
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
        <link rel="preload" href="{{ url('fonts/work-sans-v19-latin-regular.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="{{ asset('app.scss') }}">
        {% block head %}{% endblock %}
        {%- include 'partials/metatags.html.twig' with {page, site} only ~%}
        {% block structured_data %}{% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% include 'partials/header.html.twig' %}

        {% block layout %}{% endblock %}

        {% include 'partials/footer.html.twig' %}
        <script src="{{ asset('app.js') }}" defer></script>
        {% block scripts %}{% endblock %}
    </body>
</html>
