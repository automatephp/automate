{% extends '_base.html.twig' %}

{% block body_class %}body--home{% endblock %}

{% block head %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
{% endblock %}

{% block structured_data %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebSite",
                "@id": "{{ url('/', {canonical: true}) }}#website",
                "url": "{{ url('/', {canonical: true}) }}",
                "name": "{{ site.title }}",
                "description": "{{ site.description }}",
                "inLanguage": "en"
            },
            {
                "@type": "SoftwareApplication",
                "@id": "{{ url('/', {canonical: true}) }}#software",
                "name": "Automate",
                "description": "{{ site.description }}",
                "url": "{{ url('/', {canonical: true}) }}",
                "applicationCategory": "DeveloperApplication",
                "applicationSubCategory": "Deployment tool",
                "operatingSystem": "Linux, macOS",
                "softwareHelp": "{{ url('docs/introduction', {canonical: true}) }}",
                "downloadUrl": "{{ site.repository }}/releases",
                "installUrl": "{{ url('docs/installation', {canonical: true}) }}",
                "license": "https://opensource.org/licenses/MIT",
                "isAccessibleForFree": true,
                "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
                "sameAs": ["{{ site.repository }}"],
                "author": { "@type": "Person", "name": "{{ site.author.name }}", "url": "{{ site.author.url }}" }
            }
        ]
    }
    </script>
{% endblock %}

{% block layout %}
<main>
    <section class="hero">
        <div class="container hero__grid">
            <div class="hero__copy">
                {% set version = getenv('AUTOMATE_VERSION') %}
                <p class="eyebrow">{% if version %}<a class="pill" href="{{ site.repository }}/releases/tag/{{ version }}" target="_blank" rel="noopener">v{{ version }}</a>{% else %}<span class="pill">Open source</span>{% endif %} MIT licensed · Zero-downtime deployments</p>
                <h1 class="hero__title">Deploy to your servers with one command.</h1>
                <p class="hero__lead">
                    Describe your platforms and servers in a single YAML file.
                    Automate clones your repository, runs your build, and switches the release atomically,
                    from your workstation or from your CI.
                </p>
                <div class="install" data-copy-block>
                    <span class="install__prompt">$</span>
                    <code class="install__code">curl -LSs https://www.automate-deployer.com/install | bash</code>
                    <button class="install__copy" type="button" data-copy="curl -LSs https://www.automate-deployer.com/install | bash" aria-label="Copy the install command">
                        {% include 'partials/icons.html.twig' with {name: 'copy'} only %}
                    </button>
                </div>
                <div class="actions">
                    <a class="button button--primary" href="{{ url('docs/quick-start') }}">Get started {% include 'partials/icons.html.twig' with {name: 'arrow-right'} only %}</a>
                    <a class="button button--ghost" href="{{ site.repository }}" target="_blank" rel="noopener">{% include 'partials/icons.html.twig' with {name: 'github'} only %} View on GitHub</a>
                </div>
            </div>
            <div class="hero__code">
                <div class="window">
                    <div class="window__bar"><span></span><span></span><span></span><em>.automate.yml</em></div>
<pre><code class="language-yaml">repository: git@github.com:acme/shop.git

platforms:
    production:
        default_branch: main
        max_releases: 5
        servers:
            web-01:
                host: web-01.acme.io
                user: deploy
                ssh_key: /home/me/.ssh/id_ed25519
                path: /var/www/shop
            web-02:
                host: web-02.acme.io
                user: deploy
                ssh_key: /home/me/.ssh/id_ed25519
                path: /var/www/shop

shared_files: [.env.local]
shared_folders: [var/uploads]

on_deploy:
    - composer install --no-dev --optimize-autoloader
post_deploy:
    - cmd: php bin/console doctrine:migrations:migrate -n
      only: [web-01]</code></pre>
                </div>
            </div>
        </div>
    </section>

    <section class="steps">
        <div class="container">
            <ol class="steps__list">
                <li class="step">
                    <span class="step__num">1</span>
                    <h2 class="step__title">Describe</h2>
                    <p>One <code>.automate.yml</code> at the root of your project lists your platforms, servers, shared files and hooks.</p>
                </li>
                <li class="step">
                    <span class="step__num">2</span>
                    <h2 class="step__title">Deploy</h2>
                    <p><code>automate deploy production</code> connects to every server over SSH and prepares a new release in parallel.</p>
                </li>
                <li class="step">
                    <span class="step__num">3</span>
                    <h2 class="step__title">Switch</h2>
                    <p>When every hook succeeded, the <code>current</code> symlink is moved. Visitors never see a half-deployed app.</p>
                </li>
            </ol>
        </div>
    </section>

    <section class="features" id="features">
        <div class="container">
            <h2 class="section__title">Everything a deployment needs, nothing more</h2>
            <p class="section__lead">Automate does one thing: ship a Git repository or a CI build to Linux servers, safely and repeatably.</p>
            <div class="features__grid">
                <article class="feature">
                    <h3>Atomic releases</h3>
                    <p>Each deployment lives in its own timestamped folder. A single symlink switch publishes it, so there is no partial state.</p>
                </article>
                <article class="feature">
                    <h3>Zero downtime</h3>
                    <p>The previous release keeps serving traffic until the new one is complete. A failed deployment never goes live.</p>
                </article>
                <article class="feature">
                    <h3>Many servers, one run</h3>
                    <p>Hooks run in parallel on all the servers of a platform. Restrict any command to specific servers with <code>only</code>.</p>
                </article>
                <article class="feature">
                    <h3>Shared files and folders</h3>
                    <p>Keep <code>.env.local</code>, uploads or caches between releases. Automate links them into every new release.</p>
                </article>
                <article class="feature">
                    <h3>Git, CI build, or both</h3>
                    <p>Clone the repository on the server, upload the artifacts built by your CI, or mix both strategies.</p>
                </article>
                <article class="feature">
                    <h3>Any stack</h3>
                    <p>PHP, Node, Ruby, Python, static sites: if it runs on a Linux server, Automate can deploy it. A single binary, no runtime needed.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="flow">
        <div class="container flow__grid">
            <div class="flow__copy">
                <h2 class="section__title">What happens on the server</h2>
                <p class="section__lead">A layout you can inspect and understand, inspired by Capistrano.</p>
                <ol class="flow__steps">
                    <li><strong>Lock</strong> the platform so two deployments never overlap.</li>
                    <li><strong>Clone</strong> the repository into a new release folder and check out the requested branch, tag or commit.</li>
                    <li><strong>Run</strong> your <code>pre_deploy</code>, <code>on_first_deploy</code> and <code>on_deploy</code> hooks.</li>
                    <li><strong>Link</strong> shared files and folders into the release.</li>
                    <li><strong>Publish</strong> by pointing <code>current</code> to the new release, then run <code>post_deploy</code>.</li>
                    <li><strong>Clean up</strong> old releases beyond <code>max_releases</code>.</li>
                </ol>
                <a class="link-arrow" href="{{ url('docs/deployment-lifecycle') }}">Read about the deployment lifecycle {% include 'partials/icons.html.twig' with {name: 'arrow-right'} only %}</a>
            </div>
            <div class="window window--tree">
                <div class="window__bar"><span></span><span></span><span></span><em>/var/www/shop</em></div>
<pre><code class="language-plaintext">/var/www/shop
├── current -> releases/2026.10.23-1412.587
├── releases
│   ├── 2026.10.21-0930.112
│   ├── 2026.10.22-1805.341
│   └── 2026.10.23-1412.587
│       ├── .env.local -> ../../shared/.env.local
│       └── var/uploads -> ../../../shared/var/uploads
└── shared
    ├── .env.local
    └── var/uploads</code></pre>
            </div>
        </div>
    </section>

    <section class="ci">
        <div class="container ci__grid">
            <div class="window">
                <div class="window__bar"><span></span><span></span><span></span><em>.github/workflows/deploy.yml</em></div>
<pre><code class="language-yaml">deploy:
    runs-on: ubuntu-latest
    steps:
        - uses: actions/checkout@v4
        - name: Install Automate
          run: curl -LSs https://www.automate-deployer.com/install | bash
        - name: Deploy
          run: ~/.automate/bin/automate deploy production
          env:
              AUTOMATE__prod_password: ${% verbatim %}{{ secrets.PROD_PASSWORD }}{% endverbatim %}</code></pre>
            </div>
            <div class="ci__copy">
                <h2 class="section__title">Works where you work</h2>
                <p class="section__lead">Run Automate from your terminal, or from GitHub Actions, GitLab CI or any runner. Secrets are read from environment variables, never written to disk.</p>
                <a class="link-arrow" href="{{ url('docs/ci-integration') }}">See the CI integration guide {% include 'partials/icons.html.twig' with {name: 'arrow-right'} only %}</a>
            </div>
        </div>
    </section>

    <section class="cta">
        <div class="container cta__inner">
            <h2>Ready to deploy?</h2>
            <p>Install Automate, write your first <code>.automate.yml</code> and ship in five minutes.</p>
            <div class="actions">
                <a class="button button--primary" href="{{ url('docs/quick-start') }}">Read the quick start</a>
                <a class="button button--ghost" href="{{ url('docs/configuration') }}">Browse the configuration reference</a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block scripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/yaml.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/plaintext.min.js"></script>
    <script>hljs.highlightAll();</script>
{% endblock %}
